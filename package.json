{
  "name": "datadan",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CourtimusPrime/datadan.git"
  },
  "description": "PostgreSQL MCP server that gives coding agents permission-bound access to databases via a YAML config",
  "bin": {
    "datadan": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "node-sql-parser": "^5.3.8",
    "pg": "^8.13.3",
    "zod": "^3.24.4",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.13",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
